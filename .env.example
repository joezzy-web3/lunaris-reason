# Admin passcode for protected terminal actions
ADMIN_PASSCODE=

# Backend proxy (optional, e.g. https://ais-pre-...run.app)
BACKEND_API_URL=

# Cloudflare D1 SQL Persistence (Powers Vercel Serverless & Edge DB)
# 1. Account ID: Found on Cloudflare Dashboard right sidebar under "Account ID"
CLOUDFLARE_ACCOUNT_ID=
# 2. API Token: Created at dash.cloudflare.com/profile/api-tokens with "Account.D1:Edit" permissions
CLOUDFLARE_API_TOKEN=
# 3. D1 Database ID: UUID found on Workers & D1 > D1 > [Your Database] page
CLOUDFLARE_D1_DATABASE_ID=

# External Integrations
FIREBASE_API_KEY=
GEMINI_API_KEY=
LUNARIS_V2_DB_URL=

