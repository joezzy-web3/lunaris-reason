rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // OpenServ verified audit trades collection
    match /openserv_v1_trades/{tradeId} {
      allow read, write: if true;
    }

    // OpenServ test trades isolated collection
    match /openserv_v1_test_trades/{tradeId} {
      allow read, write: if true;
    }

    // OpenServ autopilot global synchronized state
    match /openserv_v1_autopilot_state/{docId} {
      allow read, write: if true;
    }

    // OpenServ consolidated audit ledger checkpoint state
    match /openserv_v1_audit_state/{docId} {
      allow read, write: if true;
    }

    // Legacy and fallback audit trades collections
    match /audit_trades/{tradeId} {
      allow read, write: if true;
    }

    // Autopilot global state collection - accessible to all concurrent terminals
    match /autopilot_state/{docId} {
      allow read, write: if true;
    }

    // Consolidated audit checkpoint state - low bandwidth single-document sync
    match /audit_state/{docId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
