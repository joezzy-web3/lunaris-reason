{
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**"
    }
  },
  "crons": [
    {
      "path": "/api/audit/trigger-daemon",
      "schedule": "*/1 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
