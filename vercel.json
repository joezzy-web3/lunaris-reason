{
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
